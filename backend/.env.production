# ======================
# MONITORING & ANALYTICS
# ======================
LOG_LEVEL=info
LOG_SECURITY_EVENTS=true
LOG_RETENTION_DAYS=90
SENTRY_DSN=https://production_sentry_dsn_configure_here@sentry.io/project-id
NEW_RELIC_LICENSE_KEY=production_new_relic_license_key
SECURITY_AUDIT_ENABLED=true

# ======================
# PERFORMANCE & CACHING
# ======================
REDIS_URL=redis://production-redis-host:6379
CACHE_TTL=3600
RATE_LIMIT_ENABLED=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_ATTEMPTS=5
RATE_LIMIT_PAYMENT_WINDOW_MS=60000
RATE_LIMIT_PAYMENT_MAX_REQUESTS=10

# ======================
# CORS & SECURITY HEADERS
# ======================
CORS_ORIGIN=https://beautybite.com,https://www.beautybite.com,https://admin.beautybite.com
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Security Headers
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION=1; mode=block
REFERRER_POLICY=strict-origin-when-cross-origin
FEATURE_POLICY="camera 'none'; microphone 'none'; geolocation 'none'"

# ======================
# FEATURE FLAGS
# ======================
FEATURE_EMAIL_VERIFICATION=true
FEATURE_TWO_FACTOR_AUTH=false
FEATURE_MAINTENANCE_MODE=false
FEATURE_RATE_LIMITING=true
FEATURE_SECURITY_MONITORING=true
FEATURE_CDN_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true

# ======================
# BACKUP & RECOVERY
# ======================
BACKUP_RETENTION_DAYS=30
MAX_BACKUPS=50
BACKUP_SCHEDULE=0 2 * * *
BACKUP_ENCRYPTION_KEY=production-backup-encryption-key-32-chars

# ======================
# FILE UPLOAD SECURITY
# ======================
MAX_FILE_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/json,model/gltf-binary
UPLOAD_VIRUS_SCAN=true

# ======================
# NETWORK SECURITY
# ======================
SSL_ENABLED=true
SSL_MIN_VERSION=TLSv1.2
SSL_CIPHERS=ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384
SECURE_COOKIES=true
COOKIE_DOMAIN=.beautybite.com

# ======================
# API SECURITY
# ======================
API_VERSION=v1
API_RATE_LIMIT_BY_IP=true
API_REQUEST_TIMEOUT=30000
API_MAX_BODY_SIZE=10mb

# ======================
# SECURITY MONITORING
# ======================
SECURITY_ALERT_EMAIL=security@beautybite.com
SECURITY_INCIDENT_RESPONSE_TEAM=security-team@beautybite.com
SECURITY_SCAN_INTERVAL=3600000

# ======================
# COMPLIANCE & PRIVACY
# ======================
GDPR_COMPLIANCE=true
DATA_RETENTION_DAYS=730
PRIVACY_POLICY_URL=https://beautybite.com/privacy
TERMS_URL=https://beautybite.com/terms

# ======================
# PERFORMANCE OPTIMIZATION
# ======================
COMPRESSION_ENABLED=true
GZIP_LEVEL=6
STATIC_CACHE_MAX_AGE=31536000
BROWSER_CACHE_ENABLED=true

# ======================
# ERROR HANDLING
# ======================
ERROR_REPORTING_ENABLED=true
ERROR_NOTIFICATION_EMAIL=errors@beautybite.com
STACK_TRACE_IN_PRODUCTION=false